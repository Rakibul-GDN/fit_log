// This is your Prisma schema file.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UnitSystem {
  METRIC
  IMPERIAL
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum ExerciseCategory {
  BARBELL
  DUMBBELL
  MACHINE
  CABLE
  BODYWEIGHT
  KETTLEBELL
  RESISTANCE_BAND
  OTHER
}

enum DayOfWeek {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum MeasurementType {
  BODY_WEIGHT
  CHEST
  WAIST
  HIPS
  LEFT_ARM
  RIGHT_ARM
  LEFT_THIGH
  RIGHT_THIGH
  LEFT_CALF
  RIGHT_CALF
  SHOULDERS
  NECK
  BODY_FAT_PERCENTAGE
}

enum MeasurementUnit {
  KG
  LBS
  CM
  INCHES
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  emailVerified  Boolean  @default(false)
  passwordHash   String
  name           String?  @db.VarChar(100)
  preferredUnits UnitSystem @default(METRIC)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  deletedAt      DateTime?

  routines          Routine[]
  workoutLogs       WorkoutLog[]
  customExercises   Exercise[]  @relation("UserCustomExercises")
  bodyMeasurements  BodyMeasurement[]
  verificationTokens VerificationToken[]

  @@index([email])
}

model VerificationToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId, type, expiresAt])
}

model Routine {
  id          String    @id @default(uuid())
  userId      String
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(500)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  exerciseAssignments ExerciseAssignment[]
  workoutLogs        WorkoutLog[]

  @@unique([userId, name])
  @@index([userId])
  @@index([deletedAt])
}

model Exercise {
  id               String    @id @default(uuid())
  name             String    @db.VarChar(100)
  description      String?   @db.VarChar(500)
  category         ExerciseCategory
  primaryMuscles   String[]
  isSystemExercise Boolean   @default(false)
  createdById      String?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())

  createdBy         User?                @relation("UserCustomExercises", fields: [createdById], references: [id])
  exerciseAssignments ExerciseAssignment[]
  logEntries         LogEntry[]

  @@unique([name, createdById])
  @@index([isSystemExercise])
  @@index([createdById])
  @@index([deletedAt])
}

model ExerciseAssignment {
  id           String    @id @default(uuid())
  routineId    String
  exerciseId   String
  dayOfWeek    DayOfWeek
  defaultSets  Int       @default(3)
  defaultReps  Int       @default(10)
  defaultWeight Float    @default(0)
  order        Int

  routine  Routine  @relation(fields: [routineId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@unique([routineId, exerciseId, dayOfWeek])
  @@index([routineId, dayOfWeek, order])
}

model WorkoutLog {
  id         String   @id @default(uuid())
  userId     String
  routineId  String?
  dayOfWeek  DayOfWeek
  workoutDate DateTime
  notes      String?  @db.VarChar(1000)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  routine    Routine?   @relation(fields: [routineId], references: [id], onDelete: SetNull)
  logEntries LogEntry[]

  @@index([userId, workoutDate])
  @@index([userId, routineId])
}

model LogEntry {
  id             String   @id @default(uuid())
  workoutLogId   String
  exerciseId     String
  setsCompleted  Int
  repsPerSet     Int[]
  weight         Float
  notes          String?  @db.VarChar(500)

  workoutLog WorkoutLog @relation(fields: [workoutLogId], references: [id], onDelete: Cascade)
  exercise   Exercise   @relation(fields: [exerciseId], references: [id], onDelete: Restrict)

  @@index([exerciseId, workoutLogId])
}

model BodyMeasurement {
  id               String           @id @default(uuid())
  userId           String
  measurementType  MeasurementType
  value            Float
  unit             MeasurementUnit
  measurementDate  DateTime         @default(now())
  notes            String?          @db.VarChar(500)
  createdAt        DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, measurementType, measurementDate])
  @@index([measurementDate])
}
